{
    "name": "app/test-agents-cursor",
    "description": "Application de test pour les fonctionnalités des Agents Cursor - Symfony + Vue.js",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/console": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/runtime": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
